{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Concilia",
  "version": "0.1.0",
  "identifier": "bo.concilia.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Concilia",
        "width": 1360,
        "height": 880,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8123 http://localhost:8123; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "category": "Business",
    "shortDescription": "Conciliación local de facturas",
    "longDescription": "Concilia Desktop permite revisar, analizar y decidir conciliaciones de facturas desde una aplicación local.",
    "icon": ["icons/icon.png"]
  }
}
