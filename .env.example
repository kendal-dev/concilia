# Copiar a .env antes de levantar el stack.

# --- Base de datos ---------------------------------------------------------
# El puerto 3307 evita chocar con una instalacion local de MySQL/MariaDB en 3306.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=reconciliation
DB_USER=reconciler
DB_PASSWORD=reconcilepass
DB_ROOT_PASSWORD=rootpass

# --- Inferencia local (QVAC) -----------------------------------------------
# Tras `npm install`, ajustar a la ruta ABSOLUTA de tu maquina.
QVAC_SDK_DIR=C:\ruta\al\proyecto\node_modules\@qvac\sdk
QVAC_BARE_PATH=C:\ruta\al\proyecto\node_modules\bare-runtime-win32-x64\bin\bare.exe

# Modelo OCR local (ID del registry QVAC o ruta al archivo de pesos).
QVAC_MODEL_OCR=PENDIENTE

CONFIDENCE_THRESHOLD=0.6
MAX_RETRIES=2

# --- Orquestador -----------------------------------------------------------
# Cliente LLM a usar:
#   stub  -> respuestas deterministas, sin QVAC
#   flaky -> stub que falla a proposito las primeras N llamadas (prueba el retry loop)
#   qvac  -> integracion real (en curso)
LLM_CLIENT=stub
LLM_MAX_RETRIES=3
