# Copiar a .env antes de levantar el stack.

# --- Base de datos ---------------------------------------------------------
# El puerto 3307 evita chocar con una instalacion local de MySQL/MariaDB en 3306.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=concilia
DB_USER=concilia
DB_PASSWORD=concilia
DB_ROOT_PASSWORD=concilia

# --- Inferencia local (QVAC) -----------------------------------------------
# Tras `npm install`, ajustar a la ruta ABSOLUTA de tu maquina.
QVAC_SDK_DIR=C:\ruta\al\proyecto\node_modules\@qvac\sdk
QVAC_BARE_PATH=C:\ruta\al\proyecto\node_modules\bare-runtime-win32-x64\bin\bare.exe

CONFIDENCE_THRESHOLD=0.6
MAX_RETRIES=2

# --- Orquestador -----------------------------------------------------------
# Cliente LLM a usar:
#   stub  -> respuestas deterministas, sin QVAC
#   flaky -> stub que falla a proposito las primeras N llamadas (prueba el retry loop)
#   qvac  -> integracion real (en curso)
LLM_CLIENT=stub
LLM_MAX_RETRIES=3

# --- OCR local (etapa 1, addon @qvac/ocr-ggml) ------------------------------
# Los modelos NO se declaran aca: ocr/engine.py los resuelve del registry de QVAC
# en cada arranque. Se bajan con: python scripts/setup_models.py
QVAC_OCR_PIPELINE=easyocr
QVAC_OCR_LANGS=es,en
# cpu | vulkan | metal | opencl. Si el backend pedido no esta, cae a cpu solo.
QVAC_OCR_BACKEND=cpu
# Canvas de deteccion. El default del addon (2560) agota la memoria del grafo de
# CRAFT cuando el modelo de texto ya esta cargado. 1280 entra comodo y es 6x mas
# rapido en tickets de ~1000 px.
QVAC_OCR_CANVAS=1280
QVAC_OCR_MAG_RATIO=1.0
# Barrido de rotacion: prueba 0/90/180/270 y se queda con la mejor lectura.
# Cuesta una pasada de OCR por angulo. Necesario para fotos de factura sin EXIF.
QVAC_OCR_ROTAR=0

# --- Modelo de texto (etapa 2) ---------------------------------------------
# Se resuelve del registry por nombre. Bajarlo con:
#   python scripts/setup_models.py --texto Qwen3.5-4B-Q4_K_M --descargar-texto
QVAC_MODEL_TEXT_NAME=Qwen3.5-4B-Q4_K_M
# El default del motor es 1024 tokens y el prompt de extraccion lo desborda.
QVAC_TEXT_CTX=4096
